# Telegram Bot Credentials
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRstuvWXyz
TELEGRAM_CHAT_ID=1234567890

# Blinkit Delivery Location (Coordinates)
BLINKIT_LAT=13.0388595
BLINKIT_LON=77.60125099999999

# Blinkit Browser Cookie (Recommended for store pinning & Cloudflare bypass)
# Copy from DevTools > Application > Cookies on https://blinkit.com
BLINKIT_COOKIE=gr_1_lat=13.0388595; gr_1_lon=77.60125099999999;

# Minimum Discount Cutoff to trigger alerts (Default: 80%)
MIN_DISCOUNT=80

# Optional Proxy URL (HTTP/HTTPS/SOCKS5) to route traffic through an Indian residential/datacenter IP
# Required if GitHub Actions US Azure datacenters are blocked by Cloudflare (HTTP 403)
# e.g., PROXY_URL=http://username:password@in.proxy-provider.com:8080
# PROXY_URL=

# Dry Run Mode (scrapes and checks deals without sending Telegram messages)
# DRY_RUN=true
